NODE_ENV=development

URL_SOURCE=sitemap

SITE_SITEMAP_URL=https://example.com/sitemap.xml

# SITE_URLS_FILE=./urls.txt
# Alternativ direkt eine Liste (Komma-, Semikolon- oder zeilengetrennt):
# SITE_URLS=https://example.com/,https://example.com/kontakt

# Pause zwischen einzelnen Seitenaufrufen in Millisekunden (Rate-Limiting)
CRAWL_DELAY_MS=500

# Zeitlimit für HTTP-Abrufe außerhalb des Browsers (Sitemap), in Millisekunden
# FETCH_TIMEOUT_MS=30000

# Kennung, unter der Didban in den Logfiles der Zielseite auftaucht
# USER_AGENT=Didban/0.1 (+Website-Monitoring)

# MAX_SITEMAP_INDEX_DEPTH=3

# Zeitlimit für einen einzelnen Seitenaufruf im Browser
# PAGE_TIMEOUT_MS=30000

# Fenstergröße des Browsers (Breite bestimmt die Screenshot-Breite)
# VIEWPORT_WIDTH=1280
# VIEWPORT_HEIGHT=800

# Empfindlichkeit des Pixelvergleichs je Pixel (0-1, kleiner = strenger)
# PIXEL_THRESHOLD=0.1

# Ab wie viel Prozent abweichender Fläche ein Bildunterschied zählt
# MIN_PIXEL_DIFF_PERCENT=0.01

# Ordner für Snapshot-Storage (lokale Dateien: JSON + PNG)
DATA_DIR=./data

# -- Laravel-Backend / DB (erst relevant, wenn Backend existiert) --
# DB_CONNECTION=pgsql
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=cms_monitor
# DB_USERNAME=cms_monitor
# DB_PASSWORD=secret
# APP_KEY=
