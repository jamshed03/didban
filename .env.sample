# --- Allgemein -------------------------------------------------------------
NODE_ENV=development

# --- Phase 1: Worker / Crawl-Konfiguration ---------------------------------
# URL der Sitemap, die als Quelle für die zu prüfenden Seiten dient
SITE_SITEMAP_URL=https://example.com/sitemap.xml

# Pause zwischen einzelnen Seitenaufrufen in Millisekunden (Rate-Limiting)
CRAWL_DELAY_MS=500

# Ordner für Snapshot-Storage (lokale Dateien: JSON + PNG)
DATA_DIR=./data

# --- Phase 3: Laravel-Backend / DB (erst relevant, wenn Backend existiert) --
# DB_CONNECTION=pgsql
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=cms_monitor
# DB_USERNAME=cms_monitor
# DB_PASSWORD=secret
# APP_KEY=
